# Copy to deploy/holodeck/.env on holodeck and fill in.
# docker compose reads DB_MON_USER / DB_MON_PASS from here at `up` time.

# Read-only monitoring user (must match sql/nola-exporter-user.sql, and exist on
# every DB in databases.list with the same credentials).
DB_MON_USER=nola_exporter
DB_MON_PASS=REPLACE_WITH_STRONG_PASSWORD

# ── Optional overrides for generate.sh (pass in the shell when running it) ───
# cAdvisor host port — defaults to 8081. Do NOT use 8080: AMP's panel owns it on
# holodeck. Override if 8081 is taken too:  CADVISOR_PORT=8082 ./generate.sh
# CADVISOR_PORT=8081
# HOLODECK_HOST=holodeck.fort.galaxy.rip
# MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.15.1
# CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
