# ─── Data Sources ──────────────────────────────────────────────────────────
PROMETHEUS_URL=http://10.0.6.42:9090
GRAFANA_URL=http://10.0.6.31:3000
GRAFANA_TOKEN=<your-grafana-service-account-token>

# InfluxDB — queried directly for OPNsense WAN traffic
INFLUXDB_URL=http://10.0.6.39:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=galaxy-lab
INFLUXDB_BUCKET=opnsense
# WAN interface name on both OPNsense firewalls (em0 verified for halt + stop)
WAN_INTERFACE=em0
# Grafana datasource UID (kept for reference, not used for WAN queries)
INFLUXDB_DATASOURCE_UID=P951FEA4DE68E13C5

# LibreNMS (optional — not yet wired up)
LIBRENMS_URL=http://10.0.7.97:8000
LIBRENMS_TOKEN=

# ─── Host Config ───────────────────────────────────────────────────────────
# Comma-separated list of Linux node hostnames (must match Prometheus instance labels)
LINUX_HOSTS=voyager,knox,union,dilithium,amp-server

# Comma-separated list of OPNsense firewall instance labels from Prometheus
FW_HOSTS=fort-opnsense,hawk-opnsense

# Proxmox hypervisor instance labels (job="node", shown with PVE badge)
PVE_HOSTS=pve

# Optional friendly names for MariaDB/MySQL exporter targets (job="mysql"), so
# several DBs read as names instead of host:port in the app. Comma-separated
# "instance=Name" pairs; the instance is the Prometheus target label.
# DB_FRIENDLY_NAMES=holodeck.fort.example.com:9104=Minecraft DB,holodeck.fort.example.com:9105=Rust DB

# ─── Authentication ─────────────────────────────────────────────────────────
# AUTH_ENABLED=true requires one of:
#   - API_TOKEN set: clients send "Authorization: Bearer <your-token>"
#   - API_TOKEN unset: requires OAuth2 proxy (Authentik/oauth2-proxy) setting X-Forwarded-User
AUTH_ENABLED=false
API_TOKEN=

# ─── CheckCle proxy (service monitoring) ────────────────────────────────────
CHECKCLE_URL=https://checkcle.example.com
CHECKCLE_EMAIL=
CHECKCLE_PASSWORD=

# ─── AMP proxy (game servers) ───────────────────────────────────────────────
AMP_URL=https://holodeck.example.com
AMP_USERNAME=
AMP_PASSWORD=

# ─── Unraid API (array + storage + containers) ──────────────────────────────
# Unraid Connect GraphQL API (the unraid-api service). Feeds the Unraid card:
# array status, total capacity, per-disk/cache mount usage + temps, and the
# container running/stopped summary. Create the key on the server under
# Settings → Management Access → API keys (needs read access to array + docker).
UNRAID_URL=http://10.0.7.19
UNRAID_API_KEY=
UNRAID_NAME=Unraid

# ─── Proxmox API ────────────────────────────────────────────────────────────
PVE_API_URL=https://10.0.4.32:8006
PVE_API_TOKEN=root@pam!nola=<token>
PVE_NODE=pve

# ─── Kiosk timing ──────────────────────────────────────────────────────────
# Milliseconds per slide (0=hosts, 1=performance, 2=alerts, 3=proxmox)
KIOSK_SLIDE_DURATIONS=15000,12000,12000,12000

# ─── LLM (Ask NOLA) ─────────────────────────────────────────────────────────
# Ollama on union (start with: docker compose --profile local-ai up -d)
OLLAMA_URL=http://10.0.6.45:11434
OLLAMA_MODEL=llama3.2:3b
# Fallback: Claude API if Ollama is unreachable
ANTHROPIC_API_KEY=
LLM_FALLBACK=true

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
TZ=America/Los_Angeles
NODE_ENV=production
